---
const { art, returnTo = '/portfolio' } = Astro.props;
const mediaType = art.data.mediaType ?? 'placeholder';
const mediaSrc = art.data.src;
const detailHref = `/artwork/${art.id}/?returnTo=${encodeURIComponent(returnTo)}`;
---

<article class="card" data-artwork-category={art.data.category}>
  <a href={detailHref} aria-label={`View ${art.data.title}`}>
    {mediaType === 'video' && mediaSrc ? (
      <video
        class="media-frame media-video"
        muted
        playsinline
        preload="metadata"
        aria-label={art.data.alt ?? art.data.title}
      >
        <source src={mediaSrc} type="video/mp4" />
      </video>
    ) : mediaSrc ? (
      <img
        class:list={[
          'media-frame media-image',
          art.data.landscapeCard && 'media-image-landscape'
        ]}
        src={mediaSrc}
        alt={art.data.alt ?? art.data.title}
      />
    ) : (
      <div
        class="card-placeholder"
        role="img"
        aria-label={art.data.alt ?? art.data.title}
        style={`background: ${art.data.placeholder};`}
      >
        <span>{art.data.title}</span>
      </div>
    )}

    <div class="card-meta">
      <h3>{art.data.title}</h3>
      <p>{art.data.medium}</p>
      <small>{art.data.dimensions}</small>
    </div>

    <div class="right">
      <small>{art.data.year}</small>
      <small>{art.data.category}</small>
    </div>
  </a>
</article>