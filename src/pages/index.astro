---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArtWorkCard from '../components/ArtWorkCard.astro';

const artwork = (await getCollection('artwork')).sort((a, b) => b.data.year - a.data.year);
const curated = artwork.find((art) => art.data.category === 'Curatorial') ?? artwork[0];
const categories : any[] = [...new Set(artwork.map((art) => art.data.category))];
---

<BaseLayout description="Selected artwork and portfolio">
  <section class="intro">
    <p class="eyebrow">Artist — Victoria, BC</p>
    <h1>Art made from<br />quiet observations.</h1>
    <p class="intro-copy">
      Paintings, photography, sketches, digital art, and curated exhibitions shaped by a sense of place.
    </p>
    <a class="text-link" href="#work">View selected work</a>
  </section>

  {
    curated && (
      <section class="exhibition">
        <div class="section-heading">
          <p class="eyebrow">Curatorial</p>
          <h2>Selected exhibition</h2>
        </div>

        <div class="exhibition-panel">
          {curated.data.mediaType === 'image' && curated.data.src ? (
            <img
              class:list={[
                "mini-art",
                curated.data.landscapeCard && "media-image-landscape"
              ]}
              src={curated.data.src}
              alt={curated.data.alt ?? curated.data.title}
            />
          ) : (
            <div
              class="mini-art"
              role="img"
              aria-label={curated.data.alt ?? curated.data.title}
              style={`background: ${curated.data.placeholder};`}
            />
          )}
          <div class="exhibition-copy">
            <h3>{curated.data.title}</h3>
            <p>
              A gathering of work exploring memory, atmosphere, and the textures of everyday life.
            </p>
            <a class="text-link" href={`/artwork/${curated.id}/`}>Explore the piece</a>
          </div>
        </div>
      </section>
    )
  }

  <section id="work" class="gallery">
    <div class="section-heading">
      <p class="eyebrow">Portfolio</p>
      <h2>Selected work</h2>
    </div>

    <div class="categories">
      {categories.map((category) => <span class="tag">{category}</span>)}
    </div>

    <div class="grid">
      {artwork.map((art) => <ArtWorkCard art={art} />)}
    </div>
  </section>
</BaseLayout>