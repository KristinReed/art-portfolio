---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const artwork = (await getCollection('artwork')).sort((a, b) => b.data.year - a.data.year);
const featuredWork = artwork.filter((art) => art.data.featured && art.data.category !== 'Curatorial');
---

<BaseLayout description="Selected artwork and portfolio">
  <!-- Landing page introduction and artist biography. -->
  <section class="intro">
    <p class="eyebrow">Artist — Victoria, BC</p>
    <h1>Memory, identity,<br />and traces of time.</h1>
    <p class="intro-copy">
      Painting, film photography, and printmaking.
    </p>
  </section>

  <section id="about" class="story">
    <p class="eyebrow">About the artist</p>
    <h2>Shayna Reed</h2>

    <div class="story-grid">
      <p>
        She primarily works in acrylic painting and has recently expanded her practice to film
        photography. She is currently pursuing a Bachelor of Fine Arts with a minor in Japanese
        Studies at the University of Victoria.
      </p>

      <p>
        Her paintings explore memory and identity, interwoven with nature and floriography. Often taking
        the form of self-like portraits, they reflect mundane realities. These ideas extend into her
        photography, which focuses on overgrowth, nature, and abandoned structures that hint at human
        presence and the passage of time.
      </p>
    </div>
  </section>

  <!-- Featured artwork carousel: exhibition details appear only when supplied in frontmatter. -->
  <section class="exhibition">
    <div class="section-heading">
      <p class="eyebrow">Featured</p>
      <h2>Featured work</h2>
    </div>

    {featuredWork.length > 0 ? (
      <div
        class="exhibition-carousel"
        data-exhibition-carousel
        role="region"
        aria-roledescription="carousel"
        aria-label="Featured work"
      >
        <div class="exhibition-list">
          {featuredWork.map((art, index) => (
            <article
              class="exhibition-panel"
              data-carousel-slide
              role="group"
              aria-roledescription="slide"
              aria-label={`${index + 1} of ${featuredWork.length}: ${art.data.title}`}
              hidden={index !== 0}
            >
              <div class="exhibition-media-slot">
                <a
                  class:list={['exhibition-art-link', art.data.landscapeCard && 'exhibition-art-link-landscape']}
                  href={`/artwork/${art.id}/?returnTo=%2F`}
                  aria-label={`View ${art.data.title}`}
                >
                  {art.data.mediaType === 'video' && art.data.src ? (
                    <video class="exhibition-art" muted playsinline preload="metadata" aria-label={art.data.alt}>
                      <source src={art.data.src} type="video/mp4" />
                    </video>
                  ) : art.data.mediaType === 'image' && art.data.src ? (
                    <img class="exhibition-art" src={art.data.src} alt={art.data.alt} />
                  ) : (
                    <div
                      class="exhibition-art exhibition-placeholder"
                      role="img"
                      aria-label={art.data.alt}
                      style={`background: ${art.data.placeholder};`}
                    >
                      <span>{art.data.title}</span>
                    </div>
                  )}
                </a>
              </div>
              <div class="exhibition-copy">
                <p class="eyebrow">{art.data.exhibitionName ? 'On exhibition' : 'Current work'}</p>
                <h3>{art.data.title}</h3>
                <p>{art.data.description}</p>
                {art.data.exhibitionName && (
                  <p class="exhibition-details">
                    <span>{art.data.exhibitionName}</span>
                    <span>{art.data.exhibitionLocation}</span>
                    <span>{art.data.exhibitionDates}</span>
                  </p>
                )}
                <a class="text-link" href={`/artwork/${art.id}/?returnTo=%2F`}>View artwork</a>
              </div>
              {featuredWork.length > 1 && (
                <div class="exhibition-carousel-controls">
                  <div class="carousel-dots" role="group" aria-label="Choose featured work">
                    {featuredWork.map((featured, dotIndex) => (
                      <button
                        type="button"
                        class="carousel-dot"
                        data-carousel-dot
                        data-slide-index={dotIndex}
                        aria-label={`Show ${featured.data.title}`}
                        aria-current={index === dotIndex ? 'true' : undefined}
                      >
                        <span class="visually-hidden">Show {featured.data.title}</span>
                      </button>
                    ))}
                  </div>
                </div>
              )}
            </article>
          ))}
        </div>
      </div>
    ) : (
      <p class="empty-state">There is no featured work to share right now.</p>
    )}
  </section>
</BaseLayout>

<script>
  // Keep the active slide and its dot in sync; rotate every five seconds while this page is visible.
  const carousels = document.querySelectorAll<HTMLElement>('[data-exhibition-carousel]');

  carousels.forEach((carousel) => {
    const slides = Array.from(carousel.querySelectorAll<HTMLElement>('[data-carousel-slide]'));
    const dots = Array.from(carousel.querySelectorAll<HTMLButtonElement>('[data-carousel-dot]'));

    if (slides.length < 2) return;

    let activeIndex = 0;
    let timer: number | undefined;

    const updateSlides = () => {
      slides.forEach((slide, index) => {
        slide.hidden = index !== activeIndex;
        slide.querySelectorAll<HTMLButtonElement>('[data-carousel-dot]').forEach((dot) => {
          if (index === activeIndex && Number(dot.dataset.slideIndex) === activeIndex) {
            dot.setAttribute('aria-current', 'true');
          } else {
            dot.removeAttribute('aria-current');
          }
        });
      });
    };

    const stopTimer = () => {
      window.clearInterval(timer);
      timer = undefined;
    };

    const startTimer = () => {
      stopTimer();
      if (!document.hidden) {
        timer = window.setInterval(() => {
          activeIndex = (activeIndex + 1) % slides.length;
          updateSlides();
        }, 5_000);
      }
    };

    const showSlide = (index: number) => {
      activeIndex = (index + slides.length) % slides.length;
      updateSlides();
      startTimer();
    };

    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        const index = Number(dot.dataset.slideIndex);
        if (Number.isInteger(index)) showSlide(index);
      });
    });

    document.addEventListener('visibilitychange', startTimer);
    updateSlides();
    startTimer();
  });
</script>