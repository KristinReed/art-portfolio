---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const artworks = await getCollection('artwork');

  return artworks.map((art, index) => ({
    params: { id: art.id },
    props: {
      art,
      prev: artworks[(index - 1 + artworks.length) % artworks.length],
      next: artworks[(index + 1) % artworks.length],
    },
  }));
}

const { art, prev, next } = Astro.props;
const mediaType = art.data.mediaType ?? 'placeholder';
const mediaSrc = art.data.src;
---

<BaseLayout title={art.data.title} description={art.data.description}>
  <section class="detail">
    <a class="back" href="/portfolio">Back to portfolio</a>

    <div class="detail-grid">
      {mediaType === 'video' && mediaSrc ? (
        <video
          class:list={[
            'media-frame detail-media',
            art.data.landscapeCard && 'media-image-landscape'
          ]}
          controls
          playsinline
          preload="metadata"
        >
          <source src={mediaSrc} type="video/mp4" />
        </video>
      ) : mediaSrc ? (
        <img
          class:list={[
            'media-frame detail-media',
            art.data.landscapeCard && 'media-image-landscape'
          ]}
          src={mediaSrc}
          alt={art.data.alt ?? art.data.title}
        />
      ) : (
        <div
          class:list={[
            'art-placeholder detail-image',
            art.data.landscapeCard && 'media-image-landscape'
          ]}
          role="img"
          aria-label={art.data.alt ?? art.data.title}
          style={`background: ${art.data.placeholder};`}
        >
          <span>{art.data.title}</span>
        </div>
      )}

      <div class="detail-copy">
        <h1>{art.data.title}</h1>
        <p>{art.data.description}</p>

        <ul>
          <li>{art.data.medium}</li>
          <li>{art.data.dimensions}</li>
          <li>{art.data.year}</li>
          {art.data.featured && (
            <>
              <li>Exhibition: {art.data.exhibitionName}</li>
              <li>On exhibition at {art.data.exhibitionLocation}</li>
              <li>{art.data.exhibitionDates}</li>
            </>
          )}
        </ul>
      </div>
    </div>

    <nav class="detail-nav">
      <a href={prev ? `/artwork/${prev.id}/` : '/portfolio'}>Previous</a>
      <a href={next ? `/artwork/${next.id}/` : '/portfolio'}>Next</a>
    </nav>
  </section>
</BaseLayout>