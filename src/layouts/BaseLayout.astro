---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title = 'Shayna Reed', description = 'Online Art Portfolio' } = Astro.props as Props;
const siteName = 'Shayna Reed';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title === 'Artist Name' ? title : `${title} | ${siteName}`}</title>
  </head>
  <body>
    <header>
      <a class="brand" href="/">{siteName}</a>
      <nav>
        <a href="/#work">Work</a>
        <a href="/curatorial">Curatorial</a>
        <a href="/about">About</a>
        <a href="/contact">Contact</a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <p>© {new Date().getFullYear()} {siteName}. All rights reserved.</p>
    </footer>
  </body>
</html>